{
    "id": "osmium-stock-control",
    "name": "Osmium Stock Control",
    "version": "0.1.0",
    "description": "Counts stock down when an order is paid, stops customers adding more than is in stock, and treats a kit's parts as stock of their own",
    "category": "shop",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",

    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },

    "autoload": [
        "models"
    ],

    "hooks": {
        "basket.line.check": ["Osmium\\Services\\StockControl\\Models\\StockHooks::basketLineCheck"],
        "order.check": ["Osmium\\Services\\StockControl\\Models\\StockHooks::orderCheck"],
        "order.paid": ["Osmium\\Services\\StockControl\\Models\\StockHooks::orderPaid"]
    },

    "migrations": "migrations/"
}
